{
  "name": "@collab/server",
  "version": "0.0.1",
  "private": true,
  "description": "协同编辑器后端：NestJS REST (:3000) + Yjs 协同 WebSocket (:3001)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "node test/integration.mjs"
  },
  "dependencies": {
    "@collab/shared": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.0",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.99",
    "nanoid": "^5.1.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
