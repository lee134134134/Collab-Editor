{
  "name": "collab-editor",
  "version": "0.0.1",
  "private": true,
  "description": "类飞书协同文档编辑器 —— pnpm monorepo (web / server / shared)",
  "scripts": {
    "dev": "pnpm --filter @collab/shared build && pnpm --filter @collab/web dev",
    "dev:server": "pnpm --filter @collab/shared build && pnpm --filter @collab/server start:dev",
    "dev:all": "pnpm --filter @collab/shared build && pnpm --parallel --filter @collab/web --filter @collab/server run dev",
    "build": "pnpm -r build",
    "type-check": "pnpm --filter @collab/shared build && pnpm -r type-check",
    "test": "pnpm --filter @collab/shared build && pnpm --filter @collab/server test",
    "test:integration": "pnpm --filter @collab/shared build && pnpm --filter @collab/server test:integration",
    "test:e2e": "pnpm --filter @collab/shared build && node scripts/e2e.mjs",
    "lint": "biome lint",
    "lint-staged": "lint-staged",
    "prepare": "husky && pnpm --filter @collab/shared build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
